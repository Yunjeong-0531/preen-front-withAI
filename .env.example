# 백엔드 주소. 비워 두면 같은 origin으로 요청하고, 개발 서버가 /api를 백엔드(기본 http://localhost:8080)로 프록시한다.
# 다른 origin을 직접 호출하려면 백엔드 CORS에 프론트 주소(http://localhost:3000)와 Authorization 헤더가 허용돼 있어야 한다.
VITE_API_BASE_URL=

# 토스페이먼츠 클라이언트 키 (공개 키). 시크릿 키는 프론트에 두지 않는다.
# 백엔드가 PG_PROVIDER=fake면 이 값 없이도 결제 흐름을 시험할 수 있다.
VITE_TOSS_CLIENT_KEY=

# (선택) 개발 서버 프록시 대상. 기본 http://localhost:8080
# VITE_DEV_PROXY_TARGET=http://localhost:8080
